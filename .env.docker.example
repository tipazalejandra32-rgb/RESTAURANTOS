# Copia como .env.docker:  copy .env.docker.example .env.docker
# Usado por docker compose (Docker Desktop)

MYSQL_ROOT_PASSWORD=cambiar_root_seguro
MYSQL_PASSWORD=cambiar_app_seguro
MYSQL_DATABASE=restaurante-facturacion-si
MYSQL_USER=restaurant

# Clave para tokens de login (mín. 32 caracteres aleatorios)
AUTH_SECRET=cambiar_por_una_clave_larga_y_aleatoria_en_produccion

# Puerto en tu PC (http://localhost:3000)
APP_PORT=3000

# Puerto MySQL en tu PC (no uses 3306 si ya tienes MySQL instalado)
MYSQL_HOST_PORT=3307
